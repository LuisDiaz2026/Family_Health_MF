# ============================================
# FAMILY HEALTH MF - VARIABLES DE ENTORNO
# Copiar este archivo como .env y llenar valores
# ============================================

# --- DJANGO CORE ---
DJANGO_SECRET_KEY=CAMBIA_ESTE_VALOR_POR_UNA_CLAVE_SEGURA_512_BYTES
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,[::1]

# --- BASE DE DATOS ---
# SQLite para desarrollo (no requiere instalación)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# PostgreSQL para pruebas/producción (opcional)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=family_health_mf
# DB_USER=postgres
# DB_PASSWORD=tu_password
# DB_HOST=localhost
# DB_PORT=5432

# ============================================================
# DESPLIEGUE EN RAILWAY (variables OPCIONALES - panel Railway)
# ============================================================
# RAILWAY_PUBLIC_DOMAIN - Inyectado AUTOMATICAMENTE por Railway
# DATABASE_URL          - Inyectado AUTOMATICAMENTE si agregas plugin PostgreSQL
# RAILWAY_VOLUME_MOUNT_PATH - Inyectado AUTOMATICAMENTE si agregas Volume

# Recomendado SI usas Railway SIN plugin PostgreSQL (solo SQLite + Volume):
#   1. Crea Volume 2GB (≈$0.50/mes). Punto de montaje por defecto /data
#   2. Activa esta variable para que SQLite use el volumen (SINO PIERDES DATOS):
# RAILWAY_VOLUME_MOUNT_PATH=/data

# Credenciales DEMO (opcional - si quieres passwords fijas en seed):
DEMO_PASS_ADMIN=
DEMO_PASS_EMP=
DEMO_PASS_C1=
DEMO_PASS_C2=
DEMO_PASS_C3=

# Ejecutar bootstrap_data.py en el 1er deploy (1 = SI, 0 = NO - default):
RAILWAY_SEED_BOOTSTRAP=1

# Rendimiento Gunicorn (solo Railway):
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# --- SEGURIDAD ---
# Sal para hashing adicional (usar cadena larga aleatoria)
HASHID_FIELD_SALT=CAMBIA_ESTA_SAL_CADENA_LARGA_ALEATORIA_2025

# Duración tokens JWT (en minutos)
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Rate limiting (intentos login)
LOGIN_MAX_ATTEMPTS=5
LOGIN_COOLDOWN_MINUTES=15

# --- FRONTEND CORS (DESARROLLO LOCAL SOLAMENTE) ---
# NOTA: En Railway, el domain *.up.railway.app se agrega AUTOMATICAMENTE
#       no hace falta agregarlo a mano aquí.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- SERVIDOR ---
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- DATOS ADMIN INICIAL (migración seed) ---
ADMIN_USERNAME=admin_fh
ADMIN_EMAIL=admin@familyhealthclub.com.co
ADMIN_PASSWORD=Cambia123$!

# --- CLUB INFO ---
CLUB_NAME=Club Family Health
CLUB_NIT=32739028-5
CLUB_CITY=Maicao, La Guajira

