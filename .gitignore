# --- Python / Django ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
eggs/
*.egg
.eggs/
pip-wheel-metadata/
share/python-wheels/
*.whl

# Entorno virtual (todas las variantes y renombrados de Python 3.14 SIN FIXES)
venv/
env/
ENV/
.venv/
.virtualenv/
venv_RETIRENME_PY314_SIN_FIXES/
venv_*/
env_*/
.venv_*/

# Carpetas workspace / caché del IDE
Tesis_Luis.code-workspace
*.code-workspace

# Django - Media & Static (excepto initial)
backend/media/*
!backend/media/.gitkeep
backend/staticfiles/*
!backend/staticfiles/.gitkeep
backend/static/*
!backend/static/.gitkeep

# Django Database (SQLite desarrollo)
*.db
*.sqlite3
backend/db.sqlite3

# --- Node.js / Vue / Vite ---
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- IDE / Editors ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project

# --- OS ---
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store
.AppleDouble
.LSOverride

# --- Variables de entorno ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.bak
*.tmp

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

