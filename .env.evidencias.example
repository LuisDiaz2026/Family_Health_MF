# ============================================
# FAMILY HEALTH MF - CREDENCIALES PARA EVIDENCIAS
# ============================================
# Copia este archivo como ".env.evidencias" (SIN el sufijo .example) y coloca
# las contrasenas DEMO del entorno de Railway. El archivo ".env.evidencias"
# esta ignorado por Git y no debe subirse al repositorio.
#
# Los scripts de evidencia (tests/railway_validation.py, tests/metricas_operacion.py,
# tests/benchmark_aplicativo.py) y las pruebas mobile leen las claves de aqui,
# por lo que las contrasenas no se escriben nunca en el codigo ni en los comandos.
# ---------------------------------------------------------------------------

# Entorno a evaluar (por defecto la URL de produccion en Railway)
FH_BASE=https://familyhealthmf-production.up.railway.app

# Administrador
FH_USER_ADMIN=admin_fh
FH_PASS_ADMIN=

# Recepcion
FH_USER_RECEPCION=recepcion_fh
FH_PASS_RECEPCION=

# Cafeteria
FH_USER_CAFETERIA=cafeteria_fh
FH_PASS_CAFETERIA=

# Cliente 1
FH_USER_CLIENTE1=cliente1_fh
FH_PASS_CLIENTE1=

# Cliente 2
FH_USER_CLIENTE2=cliente2_fh
FH_PASS_CLIENTE2=
